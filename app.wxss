page {
  min-height: 100vh;
  background: #f6f7f3;
  color: #202622;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: 1;
  background: transparent;
}

button::after {
  border: none;
}
